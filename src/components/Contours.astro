---
// Decorative topographic contour lines, generated at build time.
// Deterministic (seeded) so the drawing is identical on every build.
interface Props {
  seed?: number;
  rings?: number;
  class?: string;
}
const { seed = 7, rings = 14, class: className } = Astro.props;

let s = seed;
const rand = () => {
  s = (s * 16807) % 2147483647;
  return (s - 1) / 2147483646;
};

const W = 800;
const H = 600;
const centers = [
  { x: W * 0.72, y: H * 0.35, r: 26, k: rings },
  { x: W * 0.18, y: H * 0.82, r: 22, k: Math.round(rings * 0.6) },
];

const paths: string[] = [];
for (const c of centers) {
  const phases = [rand() * 6.28, rand() * 6.28, rand() * 6.28];
  for (let i = 1; i <= c.k; i++) {
    const base = c.r * i;
    const pts: string[] = [];
    const steps = 72;
    for (let j = 0; j <= steps; j++) {
      const a = (j / steps) * Math.PI * 2;
      const wobble =
        1 +
        0.16 * Math.sin(a * 2 + phases[0] + i * 0.15) +
        0.08 * Math.sin(a * 3 + phases[1] - i * 0.1) +
        0.05 * Math.sin(a * 5 + phases[2]);
      const r = base * wobble;
      pts.push(`${(c.x + Math.cos(a) * r * 1.25).toFixed(1)},${(c.y + Math.sin(a) * r).toFixed(1)}`);
    }
    paths.push('M' + pts.join('L') + 'Z');
  }
}
---

<svg
  class={className}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
    {paths.map((d, i) => <path d={d} opacity={i % 5 === 4 ? 0.9 : 0.45} />)}
  </g>
</svg>
