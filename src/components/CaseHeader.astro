---
interface Meta {
  term: string;
  value: string;
  href?: string;
}
interface Props {
  kicker: string;
  title: string;
  intro: string;
  meta: Meta[];
}
const { kicker, title, intro, meta } = Astro.props;
---

<header class="case-head wrap">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/software/projects">Projects</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{title}</span>
  </nav>
  <p class="label">{kicker}</p>
  <h1>{title}</h1>
  <p class="lead">{intro}</p>
  <dl class="meta">
    {
      meta.map((m) => (
        <div>
          <dt>{m.term}</dt>
          <dd>{m.href ? <a href={m.href} rel="noopener">{m.value} <span aria-hidden="true">↗</span></a> : m.value}</dd>
        </div>
      ))
    }
  </dl>
</header>

<style>
  .case-head {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: var(--space-l);
  }

  .crumbs a {
    color: var(--muted);
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 800;
    line-height: 0.95;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-l);
    margin-top: var(--space-l);
    padding-top: var(--space-l);
    border-top: 1px solid var(--line);
  }

  dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 0.2rem;
  }

  dd {
    margin: 0;
    font-weight: 600;
  }

  dd a {
    color: var(--accent);
  }
</style>
