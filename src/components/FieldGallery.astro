---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { fieldPhotos } from '../data/engineering';

interface Props {
  limit?: number;
  cols?: 2 | 3;
}
const { limit, cols = 3 } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/field/*.jpg', { eager: true });
const photos = fieldPhotos.slice(0, limit ?? fieldPhotos.length).map((p) => ({
  ...p,
  src: files[`../assets/field/${p.file}.jpg`].default,
}));
---

<ul class={`gallery gallery--${cols}`}>
  {
    photos.map((p) => (
      <li>
        <figure>
          <Picture src={p.src} alt={p.alt} widths={[280, 420, 600]} sizes="(min-width: 56rem) 30vw, 48vw" formats={['avif', 'webp']} />
          <figcaption>{p.caption}</figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-s);
  }

  @media (min-width: 48rem) {
    .gallery--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  figure {
    display: grid;
    gap: var(--space-2xs);
  }

  figure :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border: 1px solid var(--line);
  }

  figcaption {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.35;
  }
</style>
