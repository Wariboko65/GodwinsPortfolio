---
import { Picture } from 'astro:assets';
import Profile from '../../../layouts/Profile.astro';
import { person } from '../../../data/site';
import { archive, archiveCount, type ArchiveItem } from '../../../data/software';

const variants = ['apps', 'pages', 'components'] as const;
const linkSet = (it: ArchiveItem) => [
  { href: it.live, label: 'Live site' },
  { href: it.repo, label: 'Code' },
  ...(it.solution ? [{ href: it.solution, label: 'Solution notes' }] : []),
];
---

<Profile
  path="software"
  title={`Frontend Mentor archive · ${person.fullName}`}
  description={`${archiveCount} Frontend Mentor solutions by ${person.fullName}: React applications, JavaScript apps, responsive landing pages and CSS components, each with live demo and source code.`}
>
  <header class="wrap head">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/software/projects">Projects</a> <span aria-hidden="true">/</span> <span aria-current="page">Frontend Mentor</span>
    </nav>
    <p class="label">Archive · {archiveCount} solutions</p>
    <h1>Frontend Mentor</h1>
    <p class="lead muted">
      Frontend Mentor gives you a design and a brief, and you build it. These are the solutions I have published, from
      my first CSS cards to React apps with routing and persisted state. Every one links to its live version and its
      code.
    </p>
    <a class="arrow-link" href={person.frontendMentor} rel="noopener">My Frontend Mentor profile <span aria-hidden="true">↗</span></a>
  </header>

  {
    archive.map((group, gi) => (
      <section class={`wrap group group--${variants[gi]}`} aria-labelledby={`g-${gi}`}>
        <div class="group-head">
          <h2 id={`g-${gi}`}>{group.group}</h2>
          <p class="muted">{group.intro}</p>
        </div>
        <ul class="items">
          {group.items.map((it) => (
            <li class="item" data-reveal>
              <div class="item-shot">
                <Picture
                  src={it.image}
                  alt={`Screenshot of my ${it.name} solution`}
                  widths={[360, 640, 960]}
                  sizes={gi === 2 ? '(min-width: 56rem) 25vw, 100vw' : '(min-width: 56rem) 45vw, 100vw'}
                  formats={['avif', 'webp']}
                />
              </div>
              <div class="item-body">
                <h3>{it.name}</h3>
                <p class="muted">{it.blurb}</p>
                <p class="item-tech">{it.tech.join(' · ')}</p>
                <ul class="item-links" aria-label={`${it.name} links`}>
                  {linkSet(it).map((l) => (
                    <li>
                      <a href={l.href} rel="noopener">
                        {l.label}
                        <span class="visually-hidden"> for {it.name}</span>
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Profile>

<style>
  .head {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: var(--space-l);
  }

  .crumbs a {
    color: var(--muted);
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 800;
  }

  .group {
    padding-top: var(--space-2xl);
    margin-top: var(--space-2xl);
    border-top: 1px solid var(--line);
  }

  .group-head {
    display: grid;
    gap: var(--space-2xs);
    margin-bottom: var(--space-xl);
  }

  .group-head h2 {
    font-size: var(--step-3);
  }

  .items {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-xl);
  }

  .item {
    display: grid;
    gap: var(--space-m);
    align-content: start;
  }

  .item-shot {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .item-shot :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
  }

  .item-body {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .item h3 {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .item-tech {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
  }

  .item-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .item-links a:hover {
    color: var(--accent);
  }

  /* Applications: large, two up, first one wide. */
  @media (min-width: 48rem) {
    .group--apps .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .group--apps .item:first-child {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: var(--space-xl);
      align-items: center;
    }
    .group--apps .item:first-child h3 {
      font-size: var(--step-3);
    }
  }

  /* Landing pages: horizontal rows. */
  @media (min-width: 48rem) {
    .group--pages .item {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--space-xl);
      align-items: center;
      padding-bottom: var(--space-xl);
      border-bottom: 1px dashed var(--line);
    }
    .group--pages .item:nth-child(even) .item-shot {
      order: 2;
    }
  }

  /* Components: compact grid. */
  .group--components .items {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-xl) var(--space-l);
  }

  .group--components .item h3 {
    font-size: var(--step-0);
  }

  .group--components .item p.muted {
    font-size: var(--step--1);
  }
</style>
